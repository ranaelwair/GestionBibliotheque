@model IEnumerable<GestionBibliotheque.Models.Livre>

@{
    ViewData["Title"] = "Livres";
}

<h1>Livres</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-primary" asp-action="Create">+ Ajouter un livre</a>

    @* Recherche : le texte est passé à la procédure sp_Livre_GetAll *@
    <form asp-action="Index" method="get" class="d-flex">
        <input type="text" name="recherche" value="@ViewData["Recherche"]" class="form-control me-2"
               placeholder="Titre, auteur, catégorie, ISBN..." />
        <button type="submit" class="btn btn-outline-secondary me-2">Rechercher</button>
        <a asp-action="Index" class="btn btn-outline-light text-dark border">Tout</a>
    </form>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Titre)</th>
            <th>@Html.DisplayNameFor(model => model.Auteur)</th>
            <th>@Html.DisplayNameFor(model => model.Categorie)</th>
            <th>@Html.DisplayNameFor(model => model.AnneePublication)</th>
            <th>@Html.DisplayNameFor(model => model.NbDisponibles)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Titre)</td>
            <td>@Html.DisplayFor(modelItem => item.Auteur)</td>
            <td>@Html.DisplayFor(modelItem => item.Categorie)</td>
            <td>@Html.DisplayFor(modelItem => item.AnneePublication)</td>
            <td>
                <span class="badge @(item.NbDisponibles > 0 ? "bg-success" : "bg-secondary")">
                    @item.NbDisponibles / @item.NbExemplaires
                </span>
            </td>
            <td class="text-nowrap">
                @if (item.NbDisponibles > 0)
                {
                    <a class="btn btn-sm btn-success" asp-controller="Emprunts" asp-action="Emprunter" asp-route-livreId="@item.LivreID">Emprunter</a>
                }
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.LivreID">Modifier</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.LivreID">Détails</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.LivreID">Supprimer</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Aucun livre trouvé.</p>
}
