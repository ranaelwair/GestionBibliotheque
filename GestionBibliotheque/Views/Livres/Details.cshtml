@model GestionBibliotheque.Models.Livre

@{
    ViewData["Title"] = "Détails du livre";
    var emprunts = ViewBag.Emprunts as List<GestionBibliotheque.Models.Emprunt> ?? new();
}

<h1>@Model.Titre</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Auteur)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Auteur)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ISBN)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.ISBN)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Categorie)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Categorie)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AnneePublication)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.AnneePublication)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NbExemplaires)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.NbExemplaires)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NbDisponibles)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.NbDisponibles)</dd>
</dl>

<h4>Historique des emprunts</h4>
@if (emprunts.Count == 0)
{
    <p class="text-muted">Ce livre n'a jamais été emprunté.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr><th>Membre</th><th>Emprunté le</th><th>Retour prévu</th><th>Retourné le</th><th>Pénalité</th></tr>
        </thead>
        <tbody>
        @foreach (var e in emprunts)
        {
            <tr>
                <td>@e.Membre?.NomComplet</td>
                <td>@e.DateEmprunt.ToShortDateString()</td>
                <td>@e.DateRetourPrevue.ToShortDateString()</td>
                <td>@(e.DateRetourEffective?.ToShortDateString() ?? "en cours")</td>
                <td>@e.Penalite.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
}

<div>
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.LivreID">Modifier</a>
    <a class="btn btn-link" asp-action="Index">Retour à la liste</a>
</div>
