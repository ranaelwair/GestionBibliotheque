@model GestionBibliotheque.Models.Membre

@{
    ViewData["Title"] = "Supprimer un membre";
}

<h1>Supprimer un membre</h1>

<h4 class="text-danger">Voulez-vous vraiment supprimer ce membre ?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NomComplet)</dt>
    <dd class="col-sm-9">@Model.NomComplet</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Courriel)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Courriel)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="MembreID" />
    <input type="submit" value="Supprimer" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-link">Retour à la liste</a>
</form>
